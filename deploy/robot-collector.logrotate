# /etc/logrotate.d/robot-collector
#
# P-ADE 로그 로테이션 설정
#
# 설치:
#   sudo cp deploy/robot-collector.logrotate /etc/logrotate.d/robot-collector

/home/robotuser/p-ade/logs/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d
    create 0644 robotuser robotuser
}
